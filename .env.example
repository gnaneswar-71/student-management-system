# ========================================================
# Studify — Student Management System Environment Variables
# ========================================================

# Application Port (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MySQL Database Host (e.g. 'localhost' or cloud DB host)
DB_HOST=localhost

# MySQL Database Port (Default: 3306)
DB_PORT=3306

# MySQL Database Username (e.g. 'root')
DB_USER=root

# MySQL Database Password
DB_PASSWORD=your_mysql_password_here

# MySQL Database Name
DB_NAME=student_management

# Optional: Enable SSL for hosted cloud MySQL (PlanetScale, Aiven, TiDB, Railway)
# Set to 'true' if your cloud database requires SSL
DB_SSL=false
